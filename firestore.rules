rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "karthikeyachirala@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow delete: if isAdmin();
    }

    // Claims Collection
    match /claims/{claimId} {
      allow get: if isSignedIn() && (
        resource.data.claimantUid == request.auth.uid ||
        isAdmin() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );

      allow list: if isSignedIn() && (
        resource.data.claimantUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() && isValidId(claimId) && (
        incoming().claimantUid == request.auth.uid || isAdmin()
      );

      allow update: if isSignedIn() && isValidId(claimId) && (
        resource.data.claimantUid == request.auth.uid || isAdmin()
      );

      allow delete: if isAdmin();

      // Audit Events Subcollection
      match /auditEvents/{eventId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/claims/$(claimId)).data.claimantUid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSignedIn() && isValidId(eventId);
        allow update, delete: if isAdmin();
      }
    }
  }
}
